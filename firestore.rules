rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user has their own private documents and stats
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /game_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /daily_progress/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public leaderboards: Read is public, writes must be authenticated
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
